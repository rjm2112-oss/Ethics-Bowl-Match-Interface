{
  "name": "ethics_bowl_electron",
  "version": "1.0.0",
  "description": "Local Ethics Bowl match app",
  "desktopName": "Ethics Bowl Match",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:timing": "electron . --timing-test",
    "start:timing:full:en": "electron . --timing-test --auto-start --lang=en",
    "start:timing:full:fr": "electron . --timing-test --auto-start --lang=fr-ca",
    "start:timing:one:en": "electron . --timing-test --auto-start --timing-test-limit=1 --lang=en",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.ethicsbowl.match",
    "productName": "Ethics Bowl Match",
    "files": [
      "main.js",
      "preload.js",
      "src/main/**/*.js",
      "src/shared/model-catalog.js",
      "src/shared/ai-turn-prompt.js",
      "src/shared/phase-timer-policy.js",
      "src/shared/speech-timing.js",
      "src/shared/scorecard-tally.js",
      "debater.html",
      "debater.js",
      "instructions.html",
      "styles.css",
      "app-logo.png",
      "app-logo-black.png",
      "assets/app-icon.png",
      "ethics-bowl-logo.png",
      "assets/icon.png"
    ],
    "icon": "assets/app-icon.png",
    "linux": {
      "icon": "assets/app-icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education"
    }
  },
  "allowScripts": {
    "electron@43.1.1": true,
    "electron-winstaller@5.4.0": true
  }
}
